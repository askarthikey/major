# ==============================================================================
# GNN-Constrained P2P Solar Microgrid Trading System — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=solar_p2p_trading

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite uses VITE_ prefix) ---
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# --- Simulation Defaults ---
SIMULATION_SPEED=1.0
DEFAULT_TIMESTEP_MINUTES=15

# --- ML / GNN ---
GNN_MODEL_PATH=server/ml/gnn/checkpoints/best_model.pt
GNN_FALLBACK_TO_PANDAPOWER=true

# --- Logging ---
LOG_LEVEL=INFO
